// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "unified",
  "go_to_definition_fallback": "find_all_references",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
  },
  "edit_predictions": {
    "provider": "none",
  },
  "agent": {
    "default_model": {
      "provider": "openai",
      "model": "gpt-5-mini",
      "enable_thinking": false,
    },
    "dock": "right",
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_mode": "acceptEdits",
      "default_model": "default",
    },
  },
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 17.0,
  "debugger": {
    "dock": "right",
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null,
  },
  "terminal": {
    "dock": "right",
    "font_family": "MesloLGS Nerd Font Mono",
  },
  "project_panel": {
    "dock": "left",
  },
  "relative_line_numbers": "enabled",
  "autosave": "on_window_change",
  "file_types": {
    "templ": ["*.templ"],
  },
  "cursor_blink": false,
  "scrollbar": {
    "show": "never",
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
    },
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "hide_mouse": "on_typing_and_action",
  "wrap_guides": [90],
  "show_wrap_guides": false, // ruler after a X amount of chars
  "vim_mode": true,
  "base_keymap": "Cursor",
  "ui_font_size": 17.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Madara",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null, // same values as the `diagnostics_max_severity` from the editor settings
    },
  },
}

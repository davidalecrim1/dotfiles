# Treat Option as a real Alt modifier so key combos survive the Kitty keyboard
# protocol (used by terminal multiplexers like herdr). Without this, Option is a
# compose key and option+backspace stops matching under Kitty, sending a bare
# backspace instead of a word delete.
macos-option-as-alt = true

font-family = "MesloLGS Nerd Font Mono"
font-size = 13
font-thicken = true

# Option + Backspace: Delete previous word
keybind = option+backspace=text:\x1b\x7f

# Cmd + Backspace: Delete to start of line (sends Ctrl+U / \x15)
keybind = cmd+backspace=text:\x15

theme = Vercel

background-opacity = 0.85
background-blur = 20
